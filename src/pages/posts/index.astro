---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import Layout from "../../components/layouts/Layout.astro";
import PostsList from "../../components/PostsList.tsx";

import { getFallbackImage } from "../../utils/getFallbackImage.ts";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const heroImages = Object.fromEntries(
  await Promise.all(
    posts.map(async (post) => {
      const img = await getImage({
        src: post.data.heroImage ?? getFallbackImage(post.data.pubDate),
        width: 144,
        height: 108,
      });
      return [post.id, img.src];
    }),
  ),
);
---

<Layout>
  <main class="w-full flex-grow">
    <PostsList posts={posts} heroImages={heroImages} client:load />
  </main>
</Layout>
