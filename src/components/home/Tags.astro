---
import { getCollection } from "astro:content";
import { BlurFade } from "@/components/ui/blur-fade";

const posts = await getCollection("posts");

const tagCounts: Record<string, number> = {};
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts[tag] = (tagCounts[tag] ?? 0) + 1;
  }
}
const topics = Object.entries(tagCounts)
  .sort(([a, countA], [b, countB]) => countB - countA || a.localeCompare(b))
  .map(([tag]) => tag);
---

{
  topics.length > 0 && (
    <section class="border-border/30 mx-auto max-w-280 border-b px-6 py-16">
      <BlurFade client:visible inView delay={0.1}>
        <h3 class="text-foreground mb-2 text-[20px] font-semibold">Tags</h3>
        <p class="text-muted-foreground mb-6 text-sm">
          Explore the archives by tag.
        </p>
        <div class="flex flex-wrap gap-1.5">
          {topics.map((topic) => (
            <a
              href={`/posts?tag=${encodeURIComponent(topic)}`}
              class="bg-secondary text-primary hover:bg-secondary/80 rounded-full px-3.5 py-1.5 text-sm font-semibold transition-colors"
            >
              {topic}
            </a>
          ))}
        </div>
      </BlurFade>
    </section>
  )
}
