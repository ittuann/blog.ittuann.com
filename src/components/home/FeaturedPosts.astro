---
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import { BlurFade } from "@/components/ui/blur-fade";
import FeaturedPostsInteractive from "./FeaturedPostsInteractive.tsx";
import DotField from "@/components/ui/DotField.tsx";

interface Props {
  posts: CollectionEntry<"posts">[];
  maxPosts?: number;
}

const { posts, maxPosts = 4 } = Astro.props;

const postData = await Promise.all(
  posts.slice(0, maxPosts).map(async (post) => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    pubDate: (() => {
      const d = post.data.pubDate;
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
    })(),
    heroImageSrc: post.data.heroImage
      ? (
          await getImage({
            src: post.data.heroImage,
            width: 640,
            height: 480,
            format: "webp",
          })
        ).src
      : null,
    category: post.data.category,
    tags: post.data.tags,
  })),
);
---

{
  postData.length > 0 && (
    <section class="bg-secondary/25 relative overflow-hidden">
      <div class="absolute inset-0">
        <DotField
          client:visible
          dotRadius={3.0}
          dotSpacing={12}
          bulgeStrength={90}
          glowRadius={50}
          sparkle={false}
          waveAmplitude={2}
          cursorRadius={900}
          cursorForce={0.15}
          bulgeOnly
          gradientFrom="#A855F7"
          gradientTo="#B497CF"
          glowColor="#bedbff"
        />
      </div>

      <div class="relative mx-auto max-w-280 px-6 py-16">
        <BlurFade client:idle inView direction="up">
          <div class="mb-6">
            <h2 class="text-foreground text-3xl font-bold">Featured Posts</h2>
            <p class="text-muted-foreground mt-2 text-base">
              Curated pieces from the archive.
            </p>
          </div>
        </BlurFade>

        <FeaturedPostsInteractive
          client:idle
          posts={postData}
          maxPosts={maxPosts}
        />
      </div>
    </section>
  )
}
