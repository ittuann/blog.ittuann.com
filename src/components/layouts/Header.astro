---
import ThemeToggle from "./ThemeToggle.tsx";
import HighlightLink from "@/components/HighlightLink.tsx";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/posts", label: "Blogs" },
  { href: "/about", label: "About" },
];

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const subpath = pathname.match(/[^\/]+/g);
---

<header
  class="border-border/30 bg-background/15 sticky top-0 z-50 w-full backdrop-blur-xs"
>
  <div class="mx-auto flex h-10 max-w-280 items-center justify-between px-6">
    <a href="/" class="text-primary text-2xl font-bold"> air wish Blog </a>

    {/* Navigation Links */}
    <nav class="hidden items-center gap-6 md:flex">
      {
        navLinks.map(({ href, label }) => {
          const isActive =
            href === pathname || href === "/" + (subpath?.[0] || "");
          return (
            <HighlightLink
              client:idle
              action="circle"
              iterations={1}
              href={href}
              disabled={isActive}
              className={
                isActive
                  ? "text-primary text-sm font-semibold"
                  : "text-sm font-semibold"
              }
            >
              {label}
            </HighlightLink>
          );
        })
      }
    </nav>

    {/* Theme Toggle */}
    <div class="text-primary flex items-center gap-1">
      <ThemeToggle client:idle />
    </div>
  </div>
</header>
