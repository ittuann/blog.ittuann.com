---
import { SparklesText } from "@/components/ui/sparkles-text.tsx";
import FooterWaves from "./FooterWaves.tsx";
import { IconBrandGithub, IconRss, IconMail } from "@tabler/icons-react";

const today = new Date();

const exploreLinks = [
  { href: "/", label: "Home" },
  { href: "/posts", label: "Blog" },
  { href: "/about", label: "About" },
];

const resourceLinks = [
  { href: "/rss.xml", label: "RSS Feed" },
  { href: "https://github.com/ittuann", label: "GitHub" },
  { href: "/", label: "Coop" },
];

const socialLinks = [
  {
    href: "https://github.com/ittuann",
    label: "GitHub",
    icon: IconBrandGithub,
  },
  { href: "/rss.xml", label: "RSS Feed", icon: IconRss },
  { href: "mailto:ittuann@outlook.com", label: "Email", icon: IconMail },
];
---

<footer class="mt-auto w-full">
  <div class="mx-auto max-w-280 px-6 py-12">
    <div
      class="border-border/20 bg-muted/60 relative w-full overflow-hidden rounded-3xl border"
    >
      <div class="absolute inset-0" aria-hidden="true">
        <FooterWaves client:visible />
      </div>

      <div class="relative z-10 px-6 pt-10 pb-6">
        <div class="flex flex-col justify-between gap-10 md:flex-row">
          {/* Left: Logo + description + social */}
          <div class="flex max-w-72 flex-col gap-3">
            <a href="/" class="text-foreground flex items-center gap-2">
              <img src="/avatar-circle.webp" alt="logo" class="h-6 w-6" />
              <SparklesText client:visible className="text-xl font-bold"
                >air wish Blog</SparklesText
              >
            </a>
            <p class="text-muted-foreground text-sm leading-relaxed">
              air wish digital garden
            </p>
            <div class="mt-1 flex items-center gap-2">
              {
                socialLinks.map(({ href, label, icon: Icon }) => (
                  <a
                    href={href}
                    target={href.startsWith("/") ? undefined : "_blank"}
                    aria-label={label}
                    title={label}
                    class="border-border/40 bg-background/50 text-muted-foreground hover:text-primary hover:border-primary/40 rounded-full border p-2 backdrop-blur-sm transition-colors"
                  >
                    <Icon size={16} stroke={1.5} />
                  </a>
                ))
              }
            </div>
          </div>

          {/* Right: Link columns */}
          <div class="flex gap-16">
            <nav class="flex flex-col gap-3" aria-label="Explore">
              <span
                class="text-muted-foreground text-xs font-semibold tracking-widest uppercase"
              >
                Explore
              </span>
              {
                exploreLinks.map(({ href, label }) => (
                  <a
                    href={href}
                    class="text-muted-foreground hover:text-primary text-sm transition-colors"
                  >
                    {label}
                  </a>
                ))
              }
            </nav>

            <nav class="flex flex-col gap-3" aria-label="Links">
              <span
                class="text-muted-foreground text-xs font-semibold tracking-widest uppercase"
              >
                Links
              </span>
              {
                resourceLinks.map(({ href, label }) => (
                  <a
                    href={href}
                    target={href.startsWith("/") ? undefined : "_blank"}
                    class="text-muted-foreground hover:text-primary text-sm transition-colors"
                  >
                    {label}
                  </a>
                ))
              }
            </nav>
          </div>
        </div>

        {/* Bottom: Copyright */}
        <div
          class="text-muted-foreground/70 mt-12 flex flex-col items-center justify-between gap-1 text-center text-xs sm:flex-row"
        >
          <p>
            Created with <span class="text-primary">♥</span> by {" "}
            <a
              href="https://github.com/ittuann"
              target="_blank"
              class="hover:text-foreground transition-colors"
            >
              air wish
            </a>
          </p>
          <p>&copy;2021-{today.getFullYear()} air wish</p>
        </div>
      </div>
    </div>
  </div>
</footer>
