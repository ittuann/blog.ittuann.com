---
import { SparklesText } from "@/components/ui/sparkles-text.tsx";

const today = new Date();
---

<footer
  class="border-border/20 bg-muted/60 mt-auto w-full rounded-t-xl border-t"
>
  <div class="mx-auto max-w-280 px-6 py-12">
    {/* Top section */}
    <div class="flex flex-col justify-between gap-10 md:flex-row">
      {/* Left: Logo + description */}
      <div class="flex max-w-72 flex-col gap-3">
        <a href="/" class="text-foreground flex items-center gap-2">
          <img src="/avatar-circle.webp" alt="logo" class="h-6 w-6" />
          <SparklesText client:load className="text-xl font-bold"
            >air wish Blog</SparklesText
          >
        </a>
        <p class="text-muted-foreground text-sm leading-relaxed">
          air wish digital garden
        </p>
      </div>

      {/* Right: Link columns */}
      <div class="flex gap-16">
        <div class="flex flex-col gap-3">
          <span
            class="text-muted-foreground text-xs font-semibold tracking-widest uppercase"
          >
            Explore
          </span>
          <a
            href="/"
            class="text-muted-foreground text-sm transition-colors hover:underline"
          >
            Home
          </a>
          <a
            href="/posts"
            class="text-muted-foreground text-sm transition-colors hover:underline"
          >
            Blog
          </a>
          <a
            href="/about"
            class="text-muted-foreground text-sm transition-colors hover:underline"
          >
            About
          </a>
        </div>

        <div class="flex flex-col gap-3">
          <span
            class="text-muted-foreground text-xs font-semibold tracking-widest uppercase"
          >
            Links
          </span>
          <a
            href="/rss.xml"
            target="_blank"
            class="text-muted-foreground text-sm transition-colors hover:underline"
          >
            RSS Feed
          </a>
          <a
            href="https://github.com/ittuann"
            target="_blank"
            class="text-muted-foreground text-sm transition-colors hover:underline"
          >
            GitHub
          </a>
          {/* href="/cooperation" */}
          <a
            href="/"
            class="text-muted-foreground text-sm transition-colors hover:underline"
          >
            Coop
          </a>
        </div>
      </div>
    </div>

    {/* Divider */}
    <div class="border-border my-8 border-t"></div>

    {/* Bottom section */}
    <div
      class="flex flex-col items-start justify-between gap-3 md:flex-row md:items-center"
    >
      <p class="text-muted-foreground text-sm">
        Created with <span class="text-primary">♥</span> by
        <a
          href="https://github.com/ittuann"
          target="_blank"
          class="text-foreground font-semibold hover:underline"
        >
          air wish
        </a>
      </p>
      <p class="text-muted-foreground text-sm">
        &copy;2021-{today.getFullYear()}
        air wish
      </p>
    </div>
  </div>
</footer>
