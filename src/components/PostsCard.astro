---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { BlurFade } from "@/components/ui/blur-fade";
import FormattedDate from "./FormattedDate.astro";
import { IconTags, IconSparkleHighlight } from "@tabler/icons-react";
import { MagicCard } from "@/components/ui/magic-card";

import { getFallbackImage } from "../utils/getFallbackImage.ts";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

<div class="grid grid-cols-1 gap-6">
  {
    posts.map((post) => (
      <BlurFade client:visible inView delay={0.1}>
        <MagicCard
          client:visible
          gradientColor="#7fabde"
          gradientSize={150}
          gradientBorderColor="transparent"
          className="rounded-3xl p-0"
        >
          <article class="group bg-muted/50 hover:border-border/30 hover:bg-secondary/50 flex w-full flex-col items-center gap-6 rounded-3xl border border-transparent p-3 transition-all md:flex-row">
            <a
              href={`/posts/${post.id}/`}
              class="aspect-4/3 w-full shrink-0 overflow-hidden rounded-2xl md:w-70"
            >
              <Image
                src={post.data.heroImage ?? getFallbackImage(post.data.pubDate)}
                alt="Post hero image"
                width={560}
                height={420}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </a>

            <div class="flex w-full flex-grow flex-col">
              <a href={`/posts/${post.id}/`} class="block">
                <h3 class="text-foreground group-hover:text-primary mb-2.5 text-lg font-semibold transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-muted-foreground mb-4 line-clamp-2 text-lg">
                  {post.data.description}
                </p>
              </a>
              <div class="mt-auto flex flex-wrap items-center gap-3">
                {post.data.category.map((cat) => (
                  <a
                    href={`/posts?category=${encodeURIComponent(cat)}`}
                    class="bg-secondary text-primary hover:bg-secondary/70 rounded-full px-2 py-0.5 text-sm font-semibold tracking-tight transition-colors"
                    onclick="event.stopPropagation()"
                  >
                    {cat}
                  </a>
                ))}
                <span class="text-muted-foreground text-sm">
                  <FormattedDate date={post.data.pubDate} />
                </span>
                {post.data.pinned !== undefined && (
                  <span class="text-primary">
                    <IconSparkleHighlight stroke={2} />
                  </span>
                )}
                {post.data.tags.length > 0 && (
                  <span class="text-muted-foreground flex flex-wrap gap-2 text-sm">
                    <IconTags stroke={2} />
                    {post.data.tags.map((tag) => (
                      <a
                        href={`/posts?tag=${encodeURIComponent(tag)}`}
                        class="hover:text-primary transition-colors"
                        onclick="event.stopPropagation()"
                      >
                        #{tag}
                      </a>
                    ))}
                  </span>
                )}
              </div>
            </div>
          </article>
        </MagicCard>
      </BlurFade>
    ))
  }
</div>
